#!/bin/sh
# 커밋 메시지에 AI 공동저자/생성 표기가 있으면 커밋을 거부한다.
# GitHub은 Co-authored-by 트레일러를 컨트리뷰터로 집계한다 — 한 번 올라가면 캐시가 안 지워져
# 레포를 새로 만들어야 했다(2026-10). 규칙 전문: CONTRIBUTING.md
MSG_FILE="$1"
AI='claude|anthropic|copilot|chatgpt|openai|gemini|cursor|codex|devin|aider|windsurf|noreply@anthropic'
TRAILER="^(co-authored-by|signed-off-by): *.*($AI)"
GENERATED="generated (with|by).*($AI|claude code)"
HITS=$(grep -niE "($TRAILER)|($GENERATED)" "$MSG_FILE")
if [ -n "$HITS" ]; then
  printf '\n✖ 커밋 거부: 메시지에 AI 공동저자/생성 표기가 있습니다.\n' >&2
  printf '  GitHub이 이 줄을 컨트리뷰터로 집계합니다. 아래 줄을 지우고 다시 커밋하세요:\n' >&2
  printf '%s\n' "$HITS" | sed 's/^/    /' >&2
  printf '  지침: CONTRIBUTING.md — AI 관련 흔적은 git에 올리지 않는다. (--no-verify 우회 금지)\n\n' >&2
  exit 1
fi
exit 0
